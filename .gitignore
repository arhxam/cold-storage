# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# PyInstaller (spec files in packaging/ ARE committed; build output is not)
*.spec
!packaging/*.spec
# Electron app
app/node_modules/
app/release/
# Virtual envs
.venv/
venv/
# uv
.uv/
# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
# OS
.DS_Store
# Browser automation scratch output (screenshots/snapshots for QA)
.playwright-mcp/
# Local user data — never commit anyone's actual backups.
# Anchored to repo root so it doesn't match the src/saveyourshit package
# (macOS filesystems match ignore patterns case-insensitively).
/SaveYourShit/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Local logo exploration (scratch, not part of the product)
logo-concepts/
