{
  "name": "cold-storage",
  "productName": "Cold Storage",
  "version": "0.4.0",
  "description": "Local-first backup for your own social-media data. No server.",
  "main": "main.js",
  "license": "MIT",
  "author": "Cold Storage contributors",
  "scripts": {
    "start": "electron .",
    "test": "node test/reliability.test.js && electron test/automation.test.js",
    "dist": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.coldstorage.app",
    "afterPack": "./after-pack.js",
    "productName": "Cold Storage",
    "files": [
      "main.js",
      "preload.js",
      "platforms.js",
      "automation.js",
      "store.js",
      "queue.js",
      "package.json",
      "entitlements.mac.plist",
      "assets/icon.icns"
    ],
    "extraResources": [
      {
        "from": "../dist/cold",
        "to": "cold"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
